# ============================================================
# WAJIB — Diperlukan untuk menjalankan aplikasi
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=

# ============================================================
# OPSIONAL — Build / Dev
# ============================================================
# DISABLE_HMR=true             # Set 'true' untuk matikan HMR (AI Studio)

# ============================================================
# SUPABASE EDGE FUNCTIONS — Set via Supabase Dashboard > Edge Functions
# (bukan di .env.local, dicatat di sini sebagai referensi)
# ============================================================
# XENDIT_SECRET_KEY            # Xendit secret key (Basic Auth invoice)
# XENDIT_WEBHOOK_TOKEN         # Callback token validasi webhook Xendit
# SUPABASE_URL                 # Edge Function: URL Supabase project
# SUPABASE_SERVICE_ROLE_KEY    # Edge Function: bypass RLS (admin)
# APP_URL                      # Redirect URL Xendit (default: http://localhost:3000)

# ============================================================
# MCP SERVERS — Untuk development agent (OpenCode / VS Code)
# Ekspor di environment shell atau isi di .env.local
# ============================================================
# EXA_API_KEY=                 # Exa AI (web search MCP)
# GH_TOKEN=                    # GitHub PAT (GitHub MCP)
# SUPABASE_ACCESS_TOKEN=       # Supabase MCP (management API)
